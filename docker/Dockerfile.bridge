FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Python 3.11 + dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        ffmpeg \
        espeak-ng \
        netcat-openbsd \
    && ln -sf python3.11 /usr/bin/python3 \
    && ln -sf python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY scripts/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/server.py .
COPY scripts/system_prompt.txt .
COPY scripts/tools/ tools/

# Répertoire persistant pour les modèles Piper (monté en volume)
VOLUME ["/app/models"]

ENV PIPER_DATA_DIR=/app/models/piper \
    SERVER_PORT=8080 \
    PYTHONIOENCODING=utf-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=5s --start-period=120s --retries=5 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

CMD ["python3", "server.py"]
